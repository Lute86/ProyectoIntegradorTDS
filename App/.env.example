# ─────────────────────────────────────────────────────────────────────────────
# IFTS 29 — Variables de entorno
# Copiá este archivo como .env y completá los valores marcados con (*)
# NUNCA commitees el .env al repositorio
# ─────────────────────────────────────────────────────────────────────────────

# ── Dominio (producción) ───────────────────────────────────────────────────
# Reemplazar por el dominio real cuando esté disponible.
# Se usa en Nginx para los certificados SSL y en CORS del backend.
DOMAIN=ifts29.edu.ar   # (*)

# ── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRET_LARGO_Y_SEGURO   # (*) mín. 32 caracteres
JWT_EXPIRES_IN=7d

# ── Base de datos PostgreSQL (producción) ─────────────────────────────────
POSTGRES_DB=ifts29
POSTGRES_USER=ifts29user
POSTGRES_PASSWORD=CAMBIA_ESTO_POR_UNA_PASSWORD_SEGURA  # (*)

# ── Uploads ────────────────────────────────────────────────────────────────
MAX_FILE_SIZE=20971520  # 20 MB en bytes
