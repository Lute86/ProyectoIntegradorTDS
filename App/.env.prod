# ─────────────────────────────────────────────────────────────────────────────
# IFTS 29 — Variables de entorno (Producción)
# Copiá este archivo como .env.prod y completá los valores marcados con (*)
# NUNCA commitees .env.prod al repositorio
# ─────────────────────────────────────────────────────────────────────────────

# ── Dominio ──────────────────────────────────────────────────────────────────
# Si no tenés dominio, dejá localhost (certificado auto-firmado)
DOMAIN=localhost   # (*)

# ── JWT (generado automáticamente por generate-secrets.sh) ───────────────────
JWT_SECRET=   # (*) se genera con: make setup-prod
JWT_EXPIRES_IN=7d

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ifts29
DB_USER=ifts29user
DB_PASSWORD=   # (*) se genera con: make setup-prod

# ── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://localhost

# ── Uploads ──────────────────────────────────────────────────────────────────
MAX_FILE_SIZE=20971520  # 20 MB en bytes

# ── Logs ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
