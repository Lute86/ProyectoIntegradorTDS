NODE_ENV=development
PORT=3000

# Database
DB_STORAGE=./data/dev.sqlite

# Frontend
FRONTEND_URL=http://localhost:5173

# JWT
JWT_SECRET=<REEMPLAZAR_CON_SECRETO_ALEATORIO_MIN_32_CHARS>
JWT_EXPIRES_IN=8h

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# CORS
CORS=http://localhost:5173

# DB SSL (optional, production only)
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA=<path_to_ca_cert>

# Logs
LOG_LEVEL=info
