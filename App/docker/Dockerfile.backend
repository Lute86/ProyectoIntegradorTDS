# ─────────────────────────────────────────────────────────────────────────────
# Stage 1: instalar dependencias de producción
# ─────────────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS deps

WORKDIR /app

# Dependencias de sistema para compilar módulos nativos
RUN apk add --no-cache python3 make g++

COPY backend/package*.json ./
RUN npm ci --omit=dev

# ─────────────────────────────────────────────────────────────────────────────
# Stage 2: imagen final
# ─────────────────────────────────────────────────────────────────────────────
FROM node:22-alpine

# Crear usuario no-root para seguridad
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

WORKDIR /app

# Copiar node_modules desde stage anterior
COPY --from=deps /app/node_modules ./node_modules

# Copiar código fuente del backend
COPY backend/ .

# Crear carpeta de uploads (mapeada como volumen en producción)
RUN mkdir -p uploads && chown -R appuser:appgroup /app

USER appuser

EXPOSE 3000

# Ejecutar migraciones y luego iniciar el servidor
CMD ["sh", "-c", "npx sequelize-cli db:migrate && node src/server.js"]
