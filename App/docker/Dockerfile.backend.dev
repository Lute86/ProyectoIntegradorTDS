FROM node:22-alpine

WORKDIR /app

RUN apk add --no-cache python3 make g++ sqlite

RUN npm install -g nodemon

COPY backend/package*.json ./
RUN npm install

COPY backend/ .

RUN mkdir -p uploads data

EXPOSE 3000

CMD ["sh", "-c", "npx sequelize-cli db:migrate && npx sequelize-cli db:seed:all && nodemon --watch src src/server.js"]
