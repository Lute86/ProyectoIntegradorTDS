# Dev: Vite dev server con HMR
FROM node:22-alpine

WORKDIR /app

# Instalar dependencias
COPY frontend/package*.json ./
RUN npm install

# Copiar fuente (el src/ se monta como volumen, pero sirve como fallback)
COPY frontend/ .

EXPOSE 5173

# Vite debe escuchar en 0.0.0.0 para ser accesible desde el host
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
